<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RaporBirlestir</RootNamespace>
    <AssemblyName>RaporBirlestir</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Varliklar\birlestir.ico</ApplicationIcon>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Varliklar\birlestir.ico" LogicalName="RaporBirlestir.Simge" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.2.0" />
    <PackageReference Include="PdfPig" Version="0.1.11" />
  </ItemGroup>

  <!-- Masaüstü kısayolu bin\Uygulama\RaporBirlestir.exe dosyasını açar: her Release derlemesi oraya da kopyalanır. -->
  <Target Name="UygulamaKlasorunuGuncelle" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' And '$([System.IO.Path]::GetFullPath($(OutDir)))' != '$([System.IO.Path]::GetFullPath($(MSBuildProjectDirectory)\bin\Uygulama\))'">
    <ItemGroup>
      <UygulamaDosyasi Include="$(OutDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(UygulamaDosyasi)" DestinationFiles="@(UygulamaDosyasi->'$(MSBuildProjectDirectory)\bin\Uygulama\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" ContinueOnError="WarnAndContinue" Retries="0" />
  </Target>

</Project>
