<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>ST4PlanIdCiz</RootNamespace>
    <BaseAssemblyName>ST4_Plan_ID_Ciz</BaseAssemblyName>
    <AssemblyName>$(BaseAssemblyName)_$([System.DateTime]::Now.ToString("yyyyMMdd_HHmmss"))</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Platforms>AnyCPU</Platforms>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>false</Deterministic>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- net48 çıktısı 2027 ile aynı seçim klasöründe bulunmasın. Testler kökü ayırabilir. -->
    <NetloadRootDir Condition="'$(NetloadRootDir)' == ''">$(MSBuildProjectDirectory)\..\NETLOAD</NetloadRootDir>
  </PropertyGroup>
  <!-- AutoCAD 2027 kendi .NET 10 API'sini kullanır; net48 derlemesi 2027'de Transaction.Commit sırasında
       yığın bozulmasıyla göçer (0xc0000005, il_objectAppended). 2027 derlemesi ayrı ve NETLOAD kökünü değiştirmez. -->
  <PropertyGroup Condition="'$(AutoCAD2027Build)' == 'true'">
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <BaseAssemblyName>ST4_Plan_ID_Ciz_2027</BaseAssemblyName>
    <AssemblyName>$(BaseAssemblyName)_$([System.DateTime]::Now.ToString("yyyyMMdd_HHmmss"))</AssemblyName>
    <AutoCADInstallDir>C:\Program Files\Autodesk\AutoCAD 2027</AutoCADInstallDir>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <DefineConstants>$(DefineConstants);AUTOCAD2027</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(AutoCAD2027Build)' == 'true'">
    <Reference Include="AdWindows">
      <HintPath>$(AutoCADInstallDir)\AdWindows.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <PropertyGroup>
    <AutoCADInstallDir Condition="'$(AutoCADInstallDir)' == '' and Exists('C:\Program Files\Autodesk\AutoCAD 2026\acdbmgd.dll')">C:\Program Files\Autodesk\AutoCAD 2026</AutoCADInstallDir>
    <AutoCADInstallDir Condition="'$(AutoCADInstallDir)' == '' and Exists('C:\Program Files\Autodesk\AutoCAD 2025\acdbmgd.dll')">C:\Program Files\Autodesk\AutoCAD 2025</AutoCADInstallDir>
    <AutoCADInstallDir Condition="'$(AutoCADInstallDir)' == '' and Exists('C:\Program Files\Autodesk\AutoCAD 2024\acdbmgd.dll')">C:\Program Files\Autodesk\AutoCAD 2024</AutoCADInstallDir>
    <AutoCADInstallDir Condition="'$(AutoCADInstallDir)' == '' and Exists('C:\Program Files\Autodesk\AutoCAD 2023\acdbmgd.dll')">C:\Program Files\Autodesk\AutoCAD 2023</AutoCADInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
    <PackageReference Include="PdfPig" Version="0.1.10" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <!-- AutoCAD 2027 yonetilen DLL'ler net48 ile uyumsuz; makinede 2023-2026 yoksa NuGet net48 referanslari. Cikti klasorune kopyalanmaz (AutoCAD zaten saglar). -->
    <PackageReference Include="AutoCAD.NET" Version="24.3.0" Condition="'$(AutoCADInstallDir)' == ''">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(AutoCAD2027Build)' != 'true'">
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
  <!-- Yardımcı ile ortak katman / ölçü / yazı stili ayarları (%APPDATA%\BEYKENT\katman-stil.json). -->
  <ItemGroup>
    <Compile Include="..\Ortak\BeykentStil\*.cs" Link="Ortak\%(Filename)%(Extension)" />
    <Compile Include="..\Ortak\Monolit\*.cs" Link="Ortak\Monolit\%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- SUREKLITEMELACILIMLARI antet üstü temel hatılı detayı: Yardımcı TEMELHATILI çizicisi aynen (ayar köprüsü YardimciTemelHatiliBaglanti.cs). -->
  <ItemGroup>
    <Compile Include="..\ST4_Yardimci\TemelHatiliRunner.cs" Link="Yardimci\TemelHatiliRunner.cs" />
    <Compile Include="..\ST4_Yardimci\BaDimensionStyles.cs" Link="Yardimci\BaDimensionStyles.cs" />
    <Compile Include="..\ST4_Yardimci\BaIni.cs" Link="Yardimci\BaIni.cs" />
    <Compile Include="..\ST4_Yardimci\OtoOlcuDimFactory.cs" Link="Yardimci\OtoOlcuDimFactory.cs" />
  </ItemGroup>
  <!-- DENEME2 döşeme donatısı: Yardımcı DOSEMEDONATI çizicisi aynen (köprü YardimciDosemeDonatiBaglanti.cs). -->
  <ItemGroup>
    <Compile Include="..\ST4_Yardimci\DosemeDonatiRunner.cs" Link="Yardimci\DosemeDonatiRunner.cs" />
    <Compile Include="..\ST4_Yardimci\DosemeDonatiRunner.AltDuzAlan.cs" Link="Yardimci\DosemeDonatiRunner.AltDuzAlan.cs" />
    <Compile Include="..\ST4_Yardimci\DosemeDonatiSettings.cs" Link="Yardimci\DosemeDonatiSettings.cs" />
    <Compile Include="..\ST4_Yardimci\DosemeKonsolSettings.cs" Link="Yardimci\DosemeKonsolSettings.cs" />
    <Compile Include="..\ST4_Yardimci\NtsOverlaySafe.cs" Link="Yardimci\NtsOverlaySafe.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- DWG: DxfIn DXF bazi sembol tablolarinda eInvalidSymbolTableName verebilir; ReadDwgFile ile acilir. -->
    <EmbeddedResource Include="..\antet_02.dwg" LogicalName="ST4PlanIdCiz.TemelAntet.antet_02.dwg" Condition="Exists('$(MSBuildProjectDirectory)\..\antet_02.dwg')" />
    <EmbeddedResource Include="..\dosyalar\antet_02.dwg" LogicalName="ST4PlanIdCiz.TemelAntet.antet_02.dwg" Condition="!Exists('$(MSBuildProjectDirectory)\..\antet_02.dwg') and Exists('$(MSBuildProjectDirectory)\..\dosyalar\antet_02.dwg')" />
    <!-- Eski 1:50 kalip kot isareti (Desktop\kot.dwg); ReadDwgFile ile acilir. -->
    <EmbeddedResource Include="..\YATAY_KOT.dwg" LogicalName="ST4PlanIdCiz.KotSymbol.YATAY_KOT.dwg" Condition="Exists('$(MSBuildProjectDirectory)\..\YATAY_KOT.dwg')" />
    <EmbeddedResource Include="..\dosyalar\YATAY_KOT.dwg" LogicalName="ST4PlanIdCiz.KotSymbol.YATAY_KOT.dwg" Condition="!Exists('$(MSBuildProjectDirectory)\..\YATAY_KOT.dwg') and Exists('$(MSBuildProjectDirectory)\..\dosyalar\YATAY_KOT.dwg')" />
    <!-- Temel kesiti yan detayları (Drawing2.dwg: iki takım temel detayı — sol drenaj / sağ ampatman). -->
    <EmbeddedResource Include="..\Drawing2.dwg" LogicalName="ST4PlanIdCiz.TemelDetay.Drawing2.dwg" Condition="Exists('$(MSBuildProjectDirectory)\..\Drawing2.dwg')" />
  </ItemGroup>

  <!-- ISKELEKESIT: şablonlar DLL içinde; diskte silinse bile çizim devam eder. Üstünlük: DLL yanındaki dosya. -->
  <ItemGroup>
    <EmbeddedResource Include="..\dosyalar\ISKELE_TABAN.dxf" LogicalName="ST4PlanIdCiz.IskeleKesitTemplates.ISKELE_TABAN.dxf" Condition="Exists('$(MSBuildProjectDirectory)\..\dosyalar\ISKELE_TABAN.dxf')" />
    <EmbeddedResource Include="..\dosyalar\ISKELE_D1.dxf" LogicalName="ST4PlanIdCiz.IskeleKesitTemplates.ISKELE_D1.dxf" Condition="Exists('$(MSBuildProjectDirectory)\..\dosyalar\ISKELE_D1.dxf')" />
    <EmbeddedResource Include="..\dosyalar\ISKELE_D2.dxf" LogicalName="ST4PlanIdCiz.IskeleKesitTemplates.ISKELE_D2.dxf" Condition="Exists('$(MSBuildProjectDirectory)\..\dosyalar\ISKELE_D2.dxf')" />
    <EmbeddedResource Include="..\dosyalar\ISKELE_C1.dxf" LogicalName="ST4PlanIdCiz.IskeleKesitTemplates.ISKELE_C1.dxf" Condition="Exists('$(MSBuildProjectDirectory)\..\dosyalar\ISKELE_C1.dxf')" />
    <EmbeddedResource Include="..\dosyalar\ISKELE_KESIT.dxf" LogicalName="ST4PlanIdCiz.IskeleKesitTemplates.ISKELE_KESIT.dxf" Condition="Exists('$(MSBuildProjectDirectory)\..\dosyalar\ISKELE_KESIT.dxf')" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Icons\*.png">
      <LogicalName>ST4PlanIdCiz.Icons.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- KIRISDUZELT: DONATI_TAR blok DXF (KOT/KES_DET/DONATI programa gomulu geometri) -->
  <ItemGroup>
    <EmbeddedResource Include="..\lisp\DONATI_TAR.dxf" LogicalName="ST4PlanIdCiz.KirisDuzeltBlocks.DONATI_TAR.dxf" Condition="Exists('$(MSBuildProjectDirectory)\..\lisp\DONATI_TAR.dxf')" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(AutoCADInstallDir)\acdbmgd.dll') and Exists('$(AutoCADInstallDir)\acmgd.dll')">
    <Reference Include="acdbmgd">
      <HintPath>$(AutoCADInstallDir)\acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>$(AutoCADInstallDir)\acmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="accoremgd">
      <HintPath>$(AutoCADInstallDir)\accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateAutoCADReferences" BeforeTargets="ResolveReferences" Condition="'$(AutoCADInstallDir)' != ''">
    <Error
      Condition="!Exists('$(AutoCADInstallDir)\acdbmgd.dll') or !Exists('$(AutoCADInstallDir)\acmgd.dll')"
      Text="AutoCAD .NET referanslari bulunamadi. MSBuild'e /p:AutoCADInstallDir='C:\Program Files\Autodesk\AutoCAD 20XX' verin." />
  </Target>

  <!-- NuGet AutoCAD DLL'leri ve onceki tarihli eklenti DLL'leri NETLOAD klasorunu doldurmasin. -->
  <Target Name="CleanupOutputFolder" AfterTargets="Build">
    <ItemGroup>
      <_AcadHostDlls Include="$(OutputPath)Ac*.dll;$(OutputPath)Ad*.dll;$(OutputPath)ac*.dll" />
      <_OldPluginOutputs Include="$(OutputPath)$(BaseAssemblyName)_*.dll;$(OutputPath)$(BaseAssemblyName)_*.pdb"
                         Exclude="$(OutputPath)$(AssemblyName).dll;$(OutputPath)$(AssemblyName).pdb" />
    </ItemGroup>
    <Delete Files="@(_AcadHostDlls);@(_OldPluginOutputs)" ContinueOnError="true" />
  </Target>
  <Target Name="ShowDllPath" AfterTargets="Build">
    <Message Importance="high" Text="DLL kaydedildi: $(OutputPath)$(AssemblyName).dll" />
    <Message Importance="high" Text="========================================" />
    <Message Importance="high" Text="ST4_Plan_ID_Ciz DLL YUKLEME ADRESI:" />
    <Message Importance="high" Text="  Klasor: $(MSBuildProjectDirectory)\$(OutputPath)" />
    <Message Importance="high" Text="  Dosya: $(AssemblyName).dll (her derlemede farkli tarih/saat)" />
    <Message Importance="high" Condition="'$(AutoCAD2027Build)' != 'true'" Text="  net48: $(NetloadRootDir)\Legacy-net48\$(AssemblyName).dll — AutoCAD 2027'de YUKLEMEYIN." />
    <Message Importance="high" Condition="'$(AutoCAD2027Build)' == 'true'" Text="  AutoCAD 2027: $(TargetPath) (bagimliliklariyla; otomatik dagitim kapali)." />
    <Message Importance="high" Text="========================================" />
  </Target>

  <!-- Legacy DLL yalnız sürüme özel klasöre; NETLOAD kökünden yanlış 2027 yüklemesini önler. -->
  <Target Name="CopyToNetloadFolder" AfterTargets="CleanupOutputFolder" Condition="'$(AutoCAD2027Build)' != 'true'">
    <PropertyGroup>
      <_NetloadDir>$([System.IO.Path]::GetFullPath('$(NetloadRootDir)\Legacy-net48'))</_NetloadDir>
    </PropertyGroup>
    <MakeDir Directories="$(_NetloadDir)" />
    <ItemGroup>
      <_OldNetloadPlan Include="$(_NetloadDir)\ST4_Plan_ID_Ciz_*.dll;$(_NetloadDir)\ST4_Plan_ID_Ciz_*.pdb" />
    </ItemGroup>
    <Delete Files="@(_OldNetloadPlan)" ContinueOnError="true" />
    <ItemGroup>
      <_NetloadPlugin Include="$(OutputPath)$(AssemblyName).dll" />
      <_NetloadPlugin Include="$(OutputPath)$(AssemblyName).pdb" Condition="Exists('$(OutputPath)$(AssemblyName).pdb')" />
      <_NetloadDeps Include="$(OutputPath)NetTopologySuite.dll;$(OutputPath)Microsoft.Bcl.HashCode.dll;$(OutputPath)System.Buffers.dll;$(OutputPath)System.Memory.dll;$(OutputPath)System.Numerics.Vectors.dll;$(OutputPath)System.Runtime.CompilerServices.Unsafe.dll;$(OutputPath)System.Text.Encoding.CodePages.dll;$(OutputPath)UglyToad.PdfPig*.dll;$(OutputPath)ST4_Aks_Ciz_CSharp*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_NetloadPlugin)" DestinationFolder="$(_NetloadDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(_NetloadDeps)" DestinationFolder="$(_NetloadDir)" SkipUnchangedFiles="true" Condition="'@(_NetloadDeps)' != ''" />
    <Message Importance="high" Text="NETLOAD guncellendi: $(_NetloadDir)\$(AssemblyName).dll" />
  </Target>
  <Target Name="CopyYatayKot" AfterTargets="Build">
    <PropertyGroup>
      <_NetloadDirKot>$([System.IO.Path]::GetFullPath('$(NetloadRootDir)\Legacy-net48'))</_NetloadDirKot>
    </PropertyGroup>
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\YATAY_KOT.dxf" DestinationFolder="$(OutputPath)" Condition="Exists('$(MSBuildProjectDirectory)\..\YATAY_KOT.dxf')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\YATAY_KOT.dwg" DestinationFolder="$(OutputPath)" Condition="Exists('$(MSBuildProjectDirectory)\..\YATAY_KOT.dwg')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\YATAY_KOT.dwg" DestinationFolder="$(_NetloadDirKot)" Condition="'$(AutoCAD2027Build)' != 'true' and Exists('$(MSBuildProjectDirectory)\..\YATAY_KOT.dwg')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\iskele_plan.lsp" DestinationFolder="$(OutputPath)" Condition="Exists('$(MSBuildProjectDirectory)\..\iskele_plan.lsp')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\ISKELE_KESIT.dxf" DestinationFolder="$(OutputPath)" Condition="Exists('$(MSBuildProjectDirectory)\..\ISKELE_KESIT.dxf')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\ISKELE_KESIT.dwg" DestinationFolder="$(OutputPath)" Condition="Exists('$(MSBuildProjectDirectory)\..\ISKELE_KESIT.dwg')" />
    <!-- ISKELEKESIT: taban / dikme / çapraz şablonları (köke veya dosyalar\ altına konabilir) -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\dosyalar\ISKELE_TABAN.dxf" DestinationFolder="$(OutputPath)" Condition="Exists('$(MSBuildProjectDirectory)\..\dosyalar\ISKELE_TABAN.dxf')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\dosyalar\ISKELE_D1.dxf" DestinationFolder="$(OutputPath)" Condition="Exists('$(MSBuildProjectDirectory)\..\dosyalar\ISKELE_D1.dxf')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\dosyalar\ISKELE_D2.dxf" DestinationFolder="$(OutputPath)" Condition="Exists('$(MSBuildProjectDirectory)\..\dosyalar\ISKELE_D2.dxf')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\dosyalar\ISKELE_C1.dxf" DestinationFolder="$(OutputPath)" Condition="Exists('$(MSBuildProjectDirectory)\..\dosyalar\ISKELE_C1.dxf')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\ISKELE_TABAN.dxf" DestinationFolder="$(OutputPath)" Condition="Exists('$(MSBuildProjectDirectory)\..\ISKELE_TABAN.dxf')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\ISKELE_D1.dxf" DestinationFolder="$(OutputPath)" Condition="Exists('$(MSBuildProjectDirectory)\..\ISKELE_D1.dxf')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\ISKELE_D2.dxf" DestinationFolder="$(OutputPath)" Condition="Exists('$(MSBuildProjectDirectory)\..\ISKELE_D2.dxf')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\ISKELE_C1.dxf" DestinationFolder="$(OutputPath)" Condition="Exists('$(MSBuildProjectDirectory)\..\ISKELE_C1.dxf')" />
  </Target>
</Project>
