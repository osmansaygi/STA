<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GesRaporu</RootNamespace>
    <AssemblyName>GesRaporu</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Varliklar\ges.ico</ApplicationIcon>
    <Version>1.6.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Varliklar\**" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Varliklar\ges.ico" LogicalName="GesRaporu.Simge" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.2.0" />
    <PackageReference Include="ACadSharp" Version="3.1.12" />
  </ItemGroup>

  <!-- Masaüstü kısayolu bin\Uygulama\GesRaporu.exe'yi açar: her Release derlemesi oraya da kopyalanır. -->
  <Target Name="UygulamaKlasorunuGuncelle" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' And '$([System.IO.Path]::GetFullPath($(OutDir)))' != '$([System.IO.Path]::GetFullPath($(MSBuildProjectDirectory)\bin\Uygulama\))'">
    <ItemGroup>
      <UygulamaDosyasi Include="$(OutDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(UygulamaDosyasi)" DestinationFiles="@(UygulamaDosyasi->'$(MSBuildProjectDirectory)\bin\Uygulama\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" ContinueOnError="WarnAndContinue" Retries="0" />
  </Target>

</Project>
